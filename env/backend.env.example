# backend/.env — copy this file there, or run `node scripts/setup-env.mjs`.
#
# Every value below is correct for a local run as it stands, EXCEPT the six
# marked GENERATE, which must be unique to your machine. The generator script
# mints them for you; the commands are given here if you would rather do it by
# hand.

# --- Database ---------------------------------------------------------------
# The local Postgres from backend/docker-compose.yml (profile `localdb`, host
# port 5434). These credentials are local-only and deliberately not secret.
#   docker compose --profile localdb up -d
DATABASE_URL="postgresql://prism:prism_local_dev@127.0.0.1:5434/prism?schema=public"
DIRECT_URL="postgresql://prism:prism_local_dev@127.0.0.1:5434/prism?schema=public"
# Used by the migration and admin tooling. Same database; kept separate so a
# deployment can point it at a higher-privilege role than the app runs as.
ADMIN_DATABASE_URL="postgresql://prism:prism_local_dev@127.0.0.1:5434/prism?schema=public"

# --- Supporting services ----------------------------------------------------
QDRANT_URL="http://localhost:6333"
REDIS_URL="redis://localhost:6379"
STORAGE_ROOT="./storage/media"

# --- API --------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5180,http://localhost:5181"
APP_BASE_URL="http://localhost:5173"
ADMIN_APP_BASE_URL="http://localhost:5180"
USER_PORTAL_URL="http://localhost:5173"
SESSION_INVITE_TTL_MINUTES="240"

# --- AI services ------------------------------------------------------------
# face-worker :8001, image-pii :8002, audio :8003, text :8004, video :8005
FACE_SERVICE_URL="http://localhost:8001"
VIDEO_SERVICE_URL="http://localhost:8005"

# --- Crypto — GENERATE, one per machine -------------------------------------
# MEDIA_KEK seals the media store. DSAR_SIGNING_SEED signs deletion
# certificates and the Ed25519 provenance stamps in exported images. Neither is
# an ordinary password: the first decrypts biometric data, the second forges
# proof about it. See env/README.md.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEDIA_KEK="GENERATE"
DSAR_SIGNING_SEED="GENERATE"
FACE_EMBEDDING_KEY="GENERATE"

# Session and audit secrets. A weak value here is not hypothetical — see
# backend/tests/security/secrets-and-tokens.test.js for the forged super_admin
# token that a shipped dev default made possible.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ADMIN_SECRET="GENERATE"
JWT_SUBJECT_SECRET="GENERATE"
AUDIT_HMAC_SECRET="GENERATE"

# Refuse to read any media object that is not encrypted. Leave this on.
MEDIA_REQUIRE_SEALED=on

# --- Capture pipelines ------------------------------------------------------
# Audio additionally needs HF_TOKEN in ai-core/audio-worker/.env.
AUDIO_CAPTURE_ENABLED="on"
VIDEO_CAPTURE_ENABLED="on"

# --- Email ------------------------------------------------------------------
# Not required. With EXPOSE_DEV_OTP on, the one-time code comes back in the API
# response and is shown on screen, so a data principal can sign in with no mail
# provider configured. Fill these in only to test real delivery.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Prism <onboarding@resend.dev>"
SMTP_HOST="in-v3.mailjet.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Prism <no-reply@prism.local>"

# Development only. `off` anywhere real — preflight.js checks this.
EXPOSE_DEV_OTP="on"

# --- Face recognition tuning ------------------------------------------------
# Tuned values, not defaults. Changing them changes who is matched to whom.
FACE_CLUSTER_THRESHOLD="0.4"
FACE_MATCH_THRESHOLD="0.38"
FACE_AUTO_TAG_THRESHOLD="0.55"
FACE_ENROLL_MIN_DET_SCORE="0.70"
FACE_MAX_ENROLLMENTS_PER_SUBJECT="5"
FACE_BLUR_KERNEL="99"
FACE_BLUR_SIGMA="30"
