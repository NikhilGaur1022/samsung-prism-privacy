# ai-core/audio-worker/.env — copy this file there, or run `node scripts/setup-env.mjs`.

ENV=development

# Required for diarisation and speaker identification, and the ONE value nobody
# can hand you: pyannote's models are licence-gated per Hugging Face account, so
# a borrowed token would not work for you anyway.
#
#   1. Create a free account at https://huggingface.co
#   2. Accept the terms on BOTH models:
#        https://huggingface.co/pyannote/speaker-diarization-3.1
#        https://huggingface.co/pyannote/segmentation-3.0
#   3. Create a read token at https://huggingface.co/settings/tokens
#
# Leave it empty to run without audio. Image, video and text are unaffected.
HF_TOKEN=""

# tiny | base | small | medium | large-v3
# `small` is the tuned trade-off: noticeably better than `base` on Indian
# English, and still loads in a few seconds. `medium` and above want a GPU.
WHISPER_MODEL_SIZE=small

# Seconds. Segments shorter than this are treated as noise rather than speech.
MIN_UTTERANCE_DURATION=1.5
