# admin-portal/.env — copy this file there, or run `node scripts/setup-env.mjs`.
#
# Vite only exposes variables prefixed VITE_ to the browser bundle. Nothing
# secret belongs in this file for that reason: whatever is here ships to every
# visitor.

# Use `localhost`, not `127.0.0.1`. The Vite dev servers bind IPv6 (::1) only,
# so the two are not interchangeable here.
VITE_API_BASE_URL="http://localhost:4000"
