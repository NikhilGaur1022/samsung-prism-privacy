# Compose interpolation only. Copy to `.env` — or let ./init.sh generate it,
# which fills the two passwords with fresh random values.
#
# `.env` is gitignored. Never commit a filled-in copy.

# The two public URLs of the deployment, with no trailing slash each. ./up.sh
# writes both automatically from the tunnels it starts; set them by hand only if
# you are pointing the stack at URLs of your own (see README.md § "A stable
# URL"). They must be DIFFERENT hostnames — the point of the split is that the
# link handed to data principals does not serve the admin console.
#
# PUBLIC_URL  admin origin (web:8080). The console lives at $PUBLIC_URL/admin.
# USER_URL    user origin  (web:8081). This is what goes into join QRs and any
#             mail to a data principal.
PUBLIC_URL=https://example.trycloudflare.com
USER_URL=https://example-user.trycloudflare.com

# Postgres owner. Runs migrations and the SQL in backend/scripts/sql; the
# application never connects as this role.
POSTGRES_PASSWORD=

# The least-privilege login role the application actually connects as. It holds
# neither SUPERUSER nor BYPASSRLS, which is what makes FORCE ROW LEVEL SECURITY
# on audit_log / access_events / deletion_certificates mean anything.
APP_DB_PASSWORD=

# Optional. Only the audio worker reads it, and only for diarization: pyannote/
# speaker-diarization-3.1 is a gated model. Accept its licence at
# https://huggingface.co/pyannote/speaker-diarization-3.1 and put a read token
# here. Leave empty and /analyze fails while /embed and /redact keep working.
HF_TOKEN=

# tiny | base | small | medium | large-v3. On CPU, anything above `small` is
# slow enough to be worth choosing deliberately.
WHISPER_MODEL_SIZE=small
