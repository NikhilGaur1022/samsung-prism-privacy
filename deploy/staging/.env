# Compose interpolation — FRESH VALUES, generated for the repository.
#
# The two passwords below are new random values, not those of any existing
# deployment. Usable as-is for a fresh stack; ./init.sh regenerates them.

# Written automatically by ./up.sh from the tunnels it starts. Set by hand only
# if you are pointing the stack at URLs of your own (README.md § "A stable URL").
# They must be DIFFERENT hostnames — the link handed to data principals must not
# serve the admin console.
PUBLIC_URL=https://example.trycloudflare.com
USER_URL=https://example-user.trycloudflare.com

# Postgres owner. Runs migrations and the SQL in backend/scripts/sql; the
# application never connects as this role.
POSTGRES_PASSWORD=d96132140d23dadbd28062112bc6e1605b2a9874bbf6b62b

# The least-privilege login role the application actually connects as. It holds
# neither SUPERUSER nor BYPASSRLS, which is what makes FORCE ROW LEVEL SECURITY
# on audit_log / access_events / deletion_certificates mean anything.
APP_DB_PASSWORD=7fa43e4cf918a7081b9448ebc96a12cbe71bf14736e317f2

# Deliberately EMPTY. A Hugging Face token belongs to a person, not to a
# deployment, so no shared value can be correct here — supply your own. Accept
# the licence at https://huggingface.co/pyannote/speaker-diarization-3.1 and put
# a read token here. Left empty, /analyze fails while /embed and /redact keep
# working.
HF_TOKEN=

# tiny | base | small | medium | large-v3. On CPU, anything above `small` is
# slow enough to be worth choosing deliberately.
WHISPER_MODEL_SIZE=small
