# Backend secrets. Copy to `app.env` — or let ./init.sh generate it, which
# fills every value below with fresh random bytes.
#
# Secrets ONLY. Every container-internal URL (Postgres, Redis, Qdrant, the five
# Python workers, STORAGE_ROOT) and every public URL is set by compose.yml and
# must not be repeated here — a stale value in this file would override it.
#
# `app.env` is gitignored. Never commit a filled-in copy. MEDIA_KEK in
# particular is not recoverable: lose it and every sealed media blob is
# permanently unreadable.

# --- The seven preflight-gated secrets. 32 bytes each, base64. --------------
AUDIT_HMAC_SECRET=""
JWT_ADMIN_SECRET=""
JWT_SUBJECT_SECRET=""
FACE_EMBEDDING_KEY=""
MEDIA_KEK=""
MEDIA_KEK_VERSION="1"
DSAR_SIGNING_SEED=""

# Flip to "on" only after `node scripts/migrate-media-encrypt.js` reports zero
# missing and zero failed. Before that it turns every legacy plaintext blob into
# a hard read error. docs/DEPLOY.md §4.
MEDIA_REQUIRE_SEALED=""

# --- Mail. Empty is fine here: NODE_ENV=development plus EXPOSE_DEV_OTP=on
# --- (both set in compose.yml) returns the one-time code in the API response,
# --- so the portal shows it and no mail needs to be delivered. Filling these in
# --- is a precondition for setting NODE_ENV=production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Prism <noreply@prism.local>"

# --- Tuning. Defaults carried from backend/.env.example. --------------------
FACE_MATCH_THRESHOLD="0.38"
FACE_AUTO_TAG_THRESHOLD="0.55"
FACE_ENROLL_MIN_DET_SCORE="0.70"
FACE_MAX_ENROLLMENTS_PER_SUBJECT="5"
FACE_CLUSTER_THRESHOLD="0.4"
FACE_BLUR_KERNEL="99"
FACE_BLUR_SIGMA="30"
VOICE_MATCH_THRESHOLD="0.10"
VOICE_MAX_ENROLLMENTS_PER_SUBJECT="3"
VOICE_ENROLL_MIN_SECONDS="3"
SESSION_INVITE_TTL_MINUTES="240"
DSAR_SLA_DAYS="30"
DSAR_INTERNAL_SLA_DAYS="7"
DSAR_PACKAGE_TTL_DAYS="30"
DSAR_PACKAGE_REISSUE_TTL_MINUTES="15"
