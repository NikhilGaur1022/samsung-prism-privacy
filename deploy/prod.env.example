# Backend application config for the deployed stack. Copy to `prod.env` and
# fill in. Secrets ONLY — hostnames live in `.env`, and every container-internal
# URL (Qdrant, Redis, the Python workers, STORAGE_ROOT) is set by
# compose.prod.yml and must not be repeated here.
#
# `prod.env` is gitignored. Never commit a filled-in copy.
# Generate every secret below with ./gen-secrets.sh.

# --- Supabase, as prism_app. NOT the postgres owner role. -------------------
# The owner holds BYPASSRLS, which makes the append-only guarantees on
# audit_log / access_events / deletion_certificates inert. preflight check #13
# fails on it. Provision with scripts/sql/provision-app-role.sql — DEPLOY.md §3.
# sslmode=require is mandatory in production; preflight fails without it.
DATABASE_URL="postgresql://prism_app.[REF]:[PW]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
DIRECT_URL="postgresql://prism_app.[REF]:[PW]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
ADMIN_DATABASE_URL="postgresql://postgres.[REF]:[PW]@[REGION].pooler.supabase.com:5432/postgres"

# --- Secrets: all seven are preflight-gated. ./gen-secrets.sh emits them. ----
AUDIT_HMAC_SECRET=""
JWT_ADMIN_SECRET=""
JWT_SUBJECT_SECRET=""
FACE_EMBEDDING_KEY=""
MEDIA_KEK=""
MEDIA_KEK_VERSION="1"
DSAR_SIGNING_SEED=""

# Flip to "on" only after `node scripts/migrate-media-encrypt.js` reports zero
# missing/failed, then redeploy. Before that it turns every legacy plaintext
# blob into a hard read error. DEPLOY.md §4.
MEDIA_REQUIRE_SEALED=""

# --- Mail. OTP login does not work without one of these. --------------------
SMTP_HOST="in-v3.mailjet.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Prism <noreply@example.com>"

# --- Audio: leave empty unless the audio profile is running. ----------------
# Empty makes every recording route answer 503 cleanly.
AUDIO_CAPTURE_ENABLED=""

# --- Tuning. Defaults carried from backend/.env.example. --------------------
FACE_MATCH_THRESHOLD="0.38"
FACE_AUTO_TAG_THRESHOLD="0.55"
FACE_ENROLL_MIN_DET_SCORE="0.70"
FACE_MAX_ENROLLMENTS_PER_SUBJECT="5"
FACE_CLUSTER_THRESHOLD="0.4"
FACE_BLUR_KERNEL="99"
FACE_BLUR_SIGMA="30"
VOICE_MATCH_THRESHOLD="0.10"
VOICE_MAX_ENROLLMENTS_PER_SUBJECT="3"
VOICE_ENROLL_MIN_SECONDS="3"
SESSION_INVITE_TTL_MINUTES="240"
DSAR_SLA_DAYS="30"
DSAR_INTERNAL_SLA_DAYS="7"
DSAR_PACKAGE_TTL_DAYS="30"
DSAR_PACKAGE_REISSUE_TTL_MINUTES="15"
