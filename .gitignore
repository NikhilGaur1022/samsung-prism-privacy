# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.next/
.env*
!.env.example

__pycache__/
cookies.txt
backend/prisma/schema.prisma.mine

# Pre-delete database backups land here. They are verbatim row dumps -- admin
# email addresses, subject records -- so they are exactly what must not be
# pushed. Local only, by design.
scratchpad/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

/tmp/models/
*.wav
*.mp3
*.png
*.jpg
# Video, for the same reason as the lines above it. The capture fixtures are
# real footage of real people; their photographs and their voices are already
# kept out of the repository and their video belongs on the same side of that
# line. Git history does not forget, so this is not something to fix later.
*.mp4
*.mov
*.webm
.huggingface/
.gitnexus

# Redis dev snapshot — a local artifact, never a source file
dump.rdb

# Deploy secrets and built portal output — never committed.
deploy/prod.env
deploy/.env
deploy/www/

# Supabase CLI local scratch state. .temp/start-secrets holds the CLI's
# well-known local demo keys and a generated DB password — worthless off this
# machine, but a secret-shaped file in git history is a liability regardless, and
# .branches is per-developer state that conflicts on every merge.
backend/supabase/.temp/
backend/supabase/.branches/
