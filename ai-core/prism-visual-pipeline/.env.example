# ──────────────────────────────────────────────────────────────
# PRISM Visual Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# Qdrant vector database
# Use ":memory:" for in-memory mode (no external Qdrant needed)
# Use "localhost" if running a Qdrant server/container
PRISM_QDRANT_HOST=:memory:
PRISM_QDRANT_PORT=6333

# Face matching
# Lower threshold = more lenient matching (good for group photos with small faces)
# Higher threshold = stricter matching (good for studio-quality selfies)
PRISM_MATCH_THRESHOLD=0.60
PRISM_MIN_DET_CONFIDENCE=0.70

# InsightFace model
PRISM_INSIGHTFACE_MODEL=buffalo_l
PRISM_DET_SIZE_W=640
PRISM_DET_SIZE_H=640

# File staging directory
PRISM_STAGING_DIR=./staging

# Blur parameters for stranger redaction
PRISM_BLUR_KERNEL_SIZE=99
PRISM_BLUR_SIGMA=30.0
