ENV=development

# Required: pyannote/speaker-diarization-3.1 is a gated Hugging Face model.
# Accept its license at https://huggingface.co/pyannote/speaker-diarization-3.1
# and generate a read token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxx

WHISPER_MODEL_SIZE=small

# No speaker-matching threshold here any more: this worker returns embeddings and
# never decides an identity. The threshold that does decide one is
# VOICE_MATCH_THRESHOLD in backend/.env.example.
#
# Minimum length of a diarised turn before an embedding is attempted for it. A
# shorter turn is reported with embedding=null and reason=TURN_TOO_SHORT, which
# the backend treats as an unidentified speaker and mutes.
MIN_UTTERANCE_DURATION=1.5

# Hints passed straight through to pyannote. Left unset the pipeline decides the
# speaker count itself; pin them when a session's roster size is known and
# diarization keeps splitting or merging speakers.
MIN_SPEAKERS=
MAX_SPEAKERS=
