DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT_REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT_REF].pooler.supabase.com:5432/postgres"

QDRANT_URL="http://localhost:6333"

STORAGE_ROOT="./storage/media"

NODE_ENV="development"
PORT="4000"

CORS_ORIGINS="http://localhost:5173,http://localhost:5180"

REDIS_URL="redis://localhost:6379"

RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="Prism <noreply@example.com>"

JWT_SUBJECT_SECRET="change-me-subject-secret"
JWT_ADMIN_SECRET="change-me-admin-secret"

APP_BASE_URL="http://localhost:5173"
ADMIN_APP_BASE_URL="http://localhost:5180"

# Origin encoded into the session join QR. A phone cannot reach "localhost" —
# use the machine's LAN IP (http://192.168.x.x:5173) or a tunnel. On-device
# selfie capture additionally needs HTTPS, so a tunnel is the realistic choice.
USER_PORTAL_URL="http://localhost:5173"
SESSION_INVITE_TTL_MINUTES="240"

AUDIT_HMAC_SECRET="dev-only-secret-change-in-prod"

FACE_SERVICE_URL="http://localhost:8001"
PII_SERVICE_URL="http://localhost:8002"
FACE_CLUSTER_THRESHOLD="0.4"

# Face matching bands. Conservative by design: a missed match costs one click,
# a wrong auto-tag puts a face into a stranger's consent bucket.
FACE_MATCH_THRESHOLD="0.38"
FACE_AUTO_TAG_THRESHOLD="0.55"
FACE_ENROLL_MIN_DET_SCORE="0.70"
# Five guided poses at registration: front, ¾-left, ¾-right, slight-up, slight-down.
FACE_MAX_ENROLLMENTS_PER_SUBJECT="5"

# REQUIRED. Enrollment embeddings are stored AES-256-GCM encrypted; the server
# refuses to boot without this rather than silently persisting plaintext vectors.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACE_EMBEDDING_KEY=""

# Master key-encryption key for media at rest (L2/L4/L6/L7/L8). Every per-project,
# per-subject and per-export DEK is derived from or wrapped under it — see
# docs/01_PRIVACY_DATAFLOW.md §3.2. REQUIRED in production: with it unset the
# store falls back to plaintext blobs, and NODE_ENV=production refuses to boot in
# that state. Setting it makes new writes sealed immediately; run
#   node scripts/migrate-media-encrypt.js
# to seal what is already on disk, then set MEDIA_REQUIRE_SEALED="on".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEDIA_KEK=""
MEDIA_KEK_VERSION="1"
# During a KEK rotation, the outgoing key stays here so blobs sealed under it
# still open. Blobs carry a keyId, so re-sealing is lazy, not a flag day.
MEDIA_KEK_PREVIOUS=""
# "on" once the backfill has finished: any remaining plaintext blob becomes a hard
# read error instead of a quiet success.
MEDIA_REQUIRE_SEALED=""

FACE_BLUR_KERNEL="99"
FACE_BLUR_SIGMA="30"

# SMTP (Mailjet) — takes priority over Resend when set. Delivers to any recipient.
SMTP_HOST="in-v3.mailjet.com"
SMTP_PORT="587"
SMTP_USER="your_mailjet_api_key"
SMTP_PASS="your_mailjet_secret_key"
MAIL_FROM="Prism <your_verified_sender@example.com>"

# --- DSAR (DPDP §11–§13) ----------------------------------------------------
# Ed25519 seed for signing deletion certificates. Without it (and without
# MEDIA_KEK to derive from) no certificate can be issued, so an erasure cannot be
# proven — preflight refuses production without it. 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DSAR_SIGNING_SEED=""
# Statutory ceiling and the internal target the SLA board reports against, so a
# breach of the real deadline is never the first warning.
DSAR_SLA_DAYS="30"
DSAR_INTERNAL_SLA_DAYS="7"
# How long a built §11 access package survives before the retention sweep shreds
# it, and how long a link re-issued to the principal in the portal stays live.
DSAR_PACKAGE_TTL_DAYS="30"
DSAR_PACKAGE_REISSUE_TTL_MINUTES="15"
