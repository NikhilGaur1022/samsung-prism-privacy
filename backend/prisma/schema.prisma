generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, uuidOssp(map: "uuid-ossp")]
}

enum SubjectGroup {
  SAMSUNG_EMPLOYEE
  EX_SAMSUNG_EMPLOYEE
  SEED_LAB_EMPLOYEE
  EX_SEED_LAB_EMPLOYEE
  VOLUNTEER
}

enum SubjectStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  // Terminal. The row survives an erasure — it anchors the ProjectConsent proof
  // that the collection was lawful, and the DSAR request itself — but every
  // identifying column has been overwritten. Distinct from INACTIVE so that
  // "erased" is never mistaken for "dormant, could be reactivated".
  ERASED
}

enum RegistrationChannel {
  SELF
  AGENT
}

model Subject {
  masterUserId String @id @default(uuid()) @map("master_user_id") @db.Uuid

  group  SubjectGroup
  status SubjectStatus @default(PENDING)

  fullName    String
  email       String  @unique @db.Citext
  phone       String?
  employeeRef String? @unique

  registrationChannel RegistrationChannel
  registeredByUserId  String?             @db.Uuid

  otpVerifiedAt DateTime?

  // DPDP §9 (children) and §14 (nomination). dateOfBirth is what gates the
  // guardian flow — a volunteer under 18 cannot self-consent, so intake must be
  // able to tell. guardianContact/nomineeContact are free-form contact strings
  // (email or phone) deliberately kept out of the auth identity columns.
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  guardianContact String?   @map("guardian_contact")
  nomineeContact  String?   @map("nominee_contact")

  refreshTokens RefreshToken[]

  projectConsents     ProjectConsent[]
  sessionParticipants SessionParticipant[]
  taggedFaces         FaceDetection[]
  suggestedClusters   FaceCluster[]
  photoLinks          PhotoSubject[]
  dsarRequests        DsarRequest[]
  purgeJobs           PurgeJob[]
  subjectKey          SubjectKey?
  dataItems           SubjectDataItem[]
  importBatches       ImportBatch[]
  audioSegments       AudioSegment[]
  textSpans           TextSpan[]
  taggedVideoTracks   VideoFaceTrack[]
  videoLinks          VideoSubject[]

  // Intake-time UX defaults ONLY. Once project_consent_matrix exists (backend-plan.md
  // Phase 2), THAT table is the sole authority for any gating/consent-check logic.
  // These three fields must never be read by media-intake, purge, or DSAR logic.
  generalTerms   Boolean @default(false)
  piiProcessing  Boolean @default(false)
  biometricMatch Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faceEnrollments  SubjectFaceEnrollment[]
  voiceEnrollments SubjectVoiceEnrollment[]

  @@index([group, status])
  @@index([employeeRef])
  @@map("data_subjects")
}

enum EnrollmentSource {
  SELF // captured by the subject in user-portal
  AGENT // captured by a collection agent in admin-portal
}

// Multi-pose capture: five angles is what makes a match survive a head turn.
// buffalo_l degrades past ~±45° yaw, so anything wider is wasted storage.
enum EnrollmentPose {
  FRONT
  LEFT
  RIGHT
  UP
  DOWN
}

// The enrollment SELFIE and its embedding are BOTH persisted. The embedding is
// encrypted at rest (AES-256-GCM, see lib/embeddingCrypto.js) and is cleared the
// moment the enrollment is deleted — the tombstone row survives for the audit
// chain, the biometric does not. It is never selected by any API response.
// Persisting it is what makes a session gallery build in seconds instead of one
// face-service round trip per enrollment per session.
model SubjectFaceEnrollment {
  id           String           @id @default(uuid()) @db.Uuid
  subjectId    String           @map("subject_id") @db.Uuid
  imagePath    String // relative to STORAGE_ROOT
  sha256       String
  detScore     Float
  width        Int?
  height       Int?
  source       EnrollmentSource
  pose         EnrollmentPose?
  // AES-256-GCM(512 × float32 LE) laid out as nonce(12) || tag(16) || ciphertext
  embedding    Bytes?
  embeddingDim Int? // 512; null = legacy row, re-derived from the selfie on use
  // Which key sealed `embedding` and the selfie at imagePath. null = legacy row
  // sealed with the global FACE_EMBEDDING_KEY; non-null = per-subject DEK from
  // lib/keyring.js, and destroying that DEK crypto-shreds this row's biometrics.
  encKeyId     String?          @map("enc_key_id")
  capturedBy   String?          @db.Uuid // AdminUser.id when source=AGENT
  createdAt    DateTime         @default(now())
  deletedAt    DateTime? // soft delete; file removed immediately

  subject Subject @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@unique([subjectId, sha256])
  @@index([subjectId, deletedAt])
  @@map("subject_face_enrollments")
}

// The voice counterpart, and deliberately the same shape for the same reasons.
//
// Before this existed there was NO persisted voice enrollment anywhere: the
// agent attached reference `voice_snippets` as multipart files at analyze time
// and the worker re-embedded every one of them on every call. Speaker identity
// therefore depended on whoever happened to attach the right WAVs to that one
// request, nothing was reusable across sessions, and there was no row to erase —
// so a voice print was held with no erasure path at all.
//
// A voice print is §2 sensitive personal data on exactly the same footing as a
// face embedding, so every property of SubjectFaceEnrollment is load-bearing
// here too: the reference clip AND its vector are persisted, the vector is
// sealed under the per-subject DEK from lib/keyring.js so destroySubjectKey()
// crypto-shreds it, `embeddingDim` records the width, a null embedding means a
// legacy row to re-derive on use, the vector is never selected by any API
// response, and delete is soft — the tombstone survives for the audit chain
// while the clip and the biometric go immediately.
//
// Note this is single-subject data, which is why it is sealed under the
// per-subject DEK. A Recording is NOT: it is a multi-speaker object, so it stays
// under the session/path DEK and erases through L14/L15/SEGMENT instead. The
// rule is about the object, not the modality.
model SubjectVoiceEnrollment {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  audioPath String @map("audio_path") // relative to STORAGE_ROOT
  sha256    String
  mimeType  String @default("audio/wav") @map("mime_type")
  sizeBytes Int    @default(0) @map("size_bytes")

  // Length of the reference clip. Short clips make a speaker embedding unstable,
  // so this is recorded and enforced at capture rather than discovered later as
  // an unexplained run of unmatched speakers.
  durationSec Float? @map("duration_sec")

  source     EnrollmentSource
  capturedBy String?          @db.Uuid // AdminUser.id when source=AGENT

  // AES-256-GCM(192 × float32 LE) laid out as nonce(12) || tag(16) || ciphertext
  // for legacy rows, or the sealed PRSM envelope for per-subject-keyed rows —
  // lib/embeddingCrypto.js reads both.
  embedding Bytes?
  // 192 for SpeechBrain ECAPA-TDNN (spkrec-ecapa-voxceleb), NOT the 512 of
  // buffalo_l. Null = legacy row, re-derived from the clip on use.
  embeddingDim Int? @map("embedding_dim")

  // Which key sealed `embedding` and the clip at audioPath. Destroying that DEK
  // crypto-shreds this row's biometric, the same as for a face enrollment.
  encKeyId String? @map("enc_key_id")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at") // soft delete; file removed immediately

  subject Subject @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@unique([subjectId, sha256])
  @@index([subjectId, deletedAt])
  @@map("subject_voice_enrollments")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String
  entityId      String   @db.Uuid
  action        String
  actorId       String?  @db.Uuid
  payloadHash   String
  // SHA-256 of the canonical payload. A hash, never the payload itself, so
  // invariant 7 holds — but storing it is what makes payloadHash recomputable and
  // therefore the chain actually verifiable. Without it, an attacker editing
  // `action` or `actorId` in place leaves a chain that still links up cleanly.
  // Null on rows written before this column existed; those verify by linkage only.
  payloadDigest String?  @map("payload_digest")
  prevHash      String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_log")
}

model AdminUser {
  id                  String      @id @default(uuid()) @db.Uuid
  email               String      @unique @db.Citext
  passwordHash        String?
  role                AdminRole
  status              AdminStatus @default(INVITED)
  invitedByAdminId    String?     @db.Uuid
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  authTokens    AuthToken[]
  refreshTokens RefreshToken[]

  ownedProjects      Project[]
  projectAssignments ProjectAssignment[]
  sessions           Session[]

  @@index([role, status])
  projectExports ProjectExport[]

  @@map("admin_users")
}

enum AdminRole {
  super_admin
  dpo
  dataOwner
  collectionAgent
  dataAdmin
}

enum AdminStatus {
  INVITED
  ACTIVE
  DISABLED
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @db.Citext
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([email, purpose, consumedAt])
  @@map("otp_codes")
}

enum OtpPurpose {
  SUBJECT_LOGIN
}

model AuthToken {
  id          String           @id @default(uuid()) @db.Uuid
  adminUserId String           @db.Uuid
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

enum AuthTokenPurpose {
  ADMIN_INVITE
  ADMIN_PASSWORD_RESET
}

// (v2, changed — gap #4): two nullable FK columns + CHECK constraint, replacing the
// no-FK principalType/principalId design from v1. Chosen specifically because this
// platform's core purpose is rigorous data lifecycle management (purge/DSAR) — cascade
// delete on refresh tokens when a subject or admin is deleted actually matters here,
// not just referential-integrity hygiene for its own sake.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  subjectId   String?   @db.Uuid
  adminUserId String?   @db.Uuid
  familyId    String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  subject   Subject?   @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([adminUserId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Collection sessions & face tagging (collection-agent workflow)
// ---------------------------------------------------------------------------

// A project is a purpose. It may not collect anything until a DPO has approved
// that purpose, so the lifecycle is a real state machine, not a label:
// DRAFT -> SUBMITTED -> APPROVED | REJECTED -> ACTIVE -> CLOSED.
enum ProjectStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ACTIVE
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  purpose       String
  policyVersion String        @default("v1")
  status        ProjectStatus @default(DRAFT)
  ownerAdminId  String?       @db.Uuid
  retention     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Approval workflow. approvedByAdminId is a bare FK-less UUID on purpose: an
  // approver is an audit fact, and deleting the admin row must never cascade
  // into rewriting the approval history.
  submittedAt       DateTime?  @map("submitted_at")
  approvedAt        DateTime?  @map("approved_at")
  approvedByAdminId String?    @map("approved_by_admin_id") @db.Uuid
  rejectionReason   String?    @map("rejection_reason")
  consentTemplateId String?    @map("consent_template_id") @db.Uuid
  // Itemised data categories the project claims to need (DPDP §5 notice input),
  // e.g. ["FACE_IMAGE","NAME","EMAIL"]. Purpose limitation is checked against it.
  dataTypes         Json?      @map("data_types")
  riskLevel         RiskLevel? @map("risk_level")

  owner             AdminUser?          @relation(fields: [ownerAdminId], references: [id], onDelete: SetNull)
  consentTemplate   ConsentTemplate?    @relation(fields: [consentTemplateId], references: [id], onDelete: SetNull)
  assignments       ProjectAssignment[]
  consents          ProjectConsent[]
  sessions          Session[]
  dsarRequests      DsarRequest[]
  retentionPolicies RetentionPolicy[]
  importBatches     ImportBatch[]

  @@index([status])
  @@index([ownerAdminId])
  exports      ProjectExport[]

  @@map("projects")
}

enum ConsentTemplateStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

// The itemised notice text a Data Principal reads before signing (DPDP §5).
// Published templates are immutable: a change publishes a new version that
// supersedes the old one, because a consent given in the past was given against
// the exact words shown at the time, and those words have to stay retrievable.
model ConsentTemplate {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  version          Int                   @default(1)
  status           ConsentTemplateStatus @default(DRAFT)
  purpose          String
  // { "en": "...", "hi": "...", "kn": "..." } — DPDP §5(3) requires the notice be
  // available in the Eighth Schedule languages, so locale is data, not a column.
  bodyByLocale     Json                  @map("body_by_locale")
  dataTypes        Json?                 @map("data_types")
  retention        String?
  grievanceContact String?               @map("grievance_contact")
  supersedesId     String?               @map("supersedes_id") @db.Uuid
  createdByAdminId String?               @map("created_by_admin_id") @db.Uuid
  publishedAt      DateTime?             @map("published_at")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  supersedes   ConsentTemplate?  @relation("TemplateVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ConsentTemplate[] @relation("TemplateVersions")
  projects     Project[]

  @@unique([name, version])
  @@index([status])
  @@map("consent_templates")
}

// Scopes a collection agent to the projects they may run sessions for. Every
// agent-facing query filters through this — an unassigned project 403s.
model ProjectAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  adminId    String   @db.Uuid
  assignedAt DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([projectId, adminId])
  @@index([adminId])
  @@map("project_assignments")
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  PURGED
}

// The sole authority for consent gating. Project-wide, all-or-nothing: a subject
// either consents to the project (and everything it collects, faces included) or
// they don't. The three booleans on Subject are intake-time UX defaults and are
// never read here.
model ProjectConsent {
  consentId     String        @id @default(uuid()) @db.Uuid
  subjectId     String        @db.Uuid
  projectId     String        @db.Uuid
  status        ConsentStatus @default(ACTIVE)
  policyVersion String
  signatureHash String
  consentedAt   DateTime      @default(now())
  revokedAt     DateTime?

  subject             Subject              @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionParticipants SessionParticipant[]
  photos              PhotoSubject[]
  audioSegments       AudioSegment[]
  textSpans           TextSpan[]
  videos              VideoSubject[]

  @@unique([subjectId, projectId])
  @@index([projectId, status])
  @@map("project_consent_matrix")
}

// What a session collects. The three paths do not share a detail page: an audio
// session's work is a waveform timeline, a text session's is a character-offset
// editor, and neither makes sense over a photo grid. IMAGE is the default so
// every session created before the split keeps its existing behaviour.
enum SessionType {
  IMAGE
  AUDIO
  TEXT
  // Video-only capture. IMAGE sessions can still hold clips alongside stills —
  // that is how video worked before this member existed, and those sessions are
  // still out there — so nothing keys "has video" off this value. It means "this
  // session collects clips and nothing else", which is what lets the UI drop the
  // stills panel and the end-of-session guard stop asking for a photo.
  VIDEO
}

enum SessionStatus {
  ACTIVE
  PROCESSING
  TAGGING
  // Finalize has committed the tagging decisions and dropped the gallery, and
  // redaction is now running over the frames. Added because ARCHIVED used to be
  // written in the same transaction that created the handoff, BEFORE
  // redactBystanders() was called — so a redaction failure left a session
  // archived, handed off, and holding unredacted originals, which is exactly the
  // observed state of COL-2225: ARCHIVED, ended 2026-08-18, sixteen photos still
  // PENDING.
  //
  // A session in this state is committed (the tags cannot be undone) but not yet
  // handed off. It promotes to ARCHIVED only when every photo is terminal.
  REDACTING
  ARCHIVED
  FAILED
}

model Session {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique
  projectId  String        @db.Uuid
  agentId    String        @db.Uuid
  // What this session collects. Defaults to IMAGE so every session that
  // predates the split keeps behaving exactly as it did; the agent portal
  // routes on this to decide which detail page a session opens in.
  type       SessionType   @default(IMAGE)
  status     SessionStatus @default(ACTIVE)
  location   String?
  createdAt  DateTime      @default(now())
  endedAt    DateTime?
  archivedAt DateTime?

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent        AdminUser            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  participants SessionParticipant[]
  photos       Photo[]
  clusters     FaceCluster[]
  jobs         RecognitionJob[]
  handoff      SessionHandoff?
  invites      SessionInvite[]
  recordings   Recording[]
  videos       VideoAsset[]
  documents    TextDocument[]

  @@index([agentId, status])
  @@index([projectId])
  @@map("sessions")
}

// The bearer credential behind the join QR. Deliberately NOT Session.code —
// the code is an operator-facing label printed in the UI, while this has to be
// rotatable and revocable on its own without renaming the session.
model SessionInvite {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdBy String    @db.Uuid
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_invites")
}

model SessionParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  subjectId String   @db.Uuid
  consentId String   @db.Uuid
  addedAt   DateTime @default(now())

  session Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  consent ProjectConsent @relation(fields: [consentId], references: [consentId], onDelete: Cascade)

  @@unique([sessionId, subjectId])
  @@map("session_participants")
}

enum CameraSource {
  IPHONE_LIVE
  IPHONE_UPLOAD
  DSLR
  XR
}

model Photo {
  id           String       @id @default(uuid()) @db.Uuid
  // Null for an IMPORT: there was no capture event, so there is no session, no
  // agent and no project to hang one on. Every consumer that reads
  // `photo.session` must treat it as optional — an imported frame is real data
  // about a real person and must never be silently skipped because it has no
  // session (that would be a DSAR completeness hole, not a display bug).
  sessionId    String?      @db.Uuid
  storagePath  String
  cameraSource CameraSource
  sha256       String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  takenAt      DateTime?
  createdAt    DateTime     @default(now())

  // Bystander-blurred derivative written at finalize. The original at storagePath
  // is never overwritten — downstream decides which derivative it is entitled to.
  redactedPath String? @map("redacted_path")

  // PII masking is fail-closed. DEFERRED means the image-pii-worker did not
  // confirm a mask, so the derivative must not be served and the batch must not
  // ingest — an unmasked Aadhaar leaving this system is a reportable breach.
  piiStatus PiiStatus @default(PENDING) @map("pii_status")
  // keyId of the DEK that sealed storagePath / redactedPath. null = plaintext
  // legacy blob not yet swept by scripts/migrate-media-encrypt.js.
  encKeyId  String?   @map("enc_key_id")

  session  Session?        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  faces    FaceDetection[]
  subjects PhotoSubject[]

  // Postgres treats NULLs as distinct, so this stops de-duplicating the moment
  // sessionId is null. Import de-duplication is therefore explicit in
  // import.service.ingestItem (sha256 within the subject), not implied here.
  @@unique([sessionId, sha256])
  @@index([sessionId])
  // The import de-duplication probe (`sha256` + `sessionId IS NULL` + a subject
  // link). The unique above stops covering it the moment sessionId is null,
  // because Postgres treats NULLs as distinct — so without this, every imported
  // file scans the whole photo table before it is written.
  @@index([sha256], map: "photos_sha256_idx")
  @@map("photos")
}

enum PiiStatus {
  PENDING
  CLEAN
  MASKED
  DEFERRED
  FAILED
}

enum FaceTagStatus {
  PENDING
  TAGGED
  UNKNOWN
  SKIPPED
  NOT_A_FACE
}

// Face embeddings are NEVER persisted here or in Qdrant. The worker computes them
// in memory, clusters within the session, writes the cluster assignment, and drops
// the vectors. Only the bbox, the crop, and (once tagged) the subject link survive.
model FaceDetection {
  id              String        @id @default(uuid()) @db.Uuid
  photoId         String        @db.Uuid
  clusterId       String?       @db.Uuid
  bbox            Json
  detScore        Float?
  cropPath        String?
  taggedSubjectId String?       @db.Uuid
  tagStatus       FaceTagStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  photo         Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  cluster       FaceCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  taggedSubject Subject?     @relation(fields: [taggedSubjectId], references: [masterUserId], onDelete: SetNull)

  @@index([photoId])
  @@index([clusterId])
  @@map("face_detections")
}

// One tagging card in the UI: the same person seen across N photos of a session.
model FaceCluster {
  id                 String        @id @default(uuid()) @db.Uuid
  sessionId          String        @db.Uuid
  repFaceId          String?       @db.Uuid
  // Photo faces only. Deliberately NOT redefined to include video tracks when
  // video was added: the admin portal and the handoff counts already read this
  // column, and silently changing what it counts would have moved numbers on
  // screens nobody was touching. Video is counted alongside it, never inside it.
  faceCount          Int           @default(0)
  suggestedSubjectId String?       @db.Uuid
  tagStatus          FaceTagStatus @default(PENDING)
  taggedSubjectId    String?       @db.Uuid
  createdAt          DateTime      @default(now())

  // Provenance of the tag: what the gallery scored and whether the worker applied
  // it without an agent ever looking at the card.
  matchScore Float?  @map("match_score")
  autoTagged Boolean @default(false) @map("auto_tagged")

  // The video half of the same card. A cluster can hold photo faces, video
  // tracks, or both — one person tagged once covers every appearance of them in
  // the session, which is the whole reason tracks join the existing clusters
  // instead of getting a parallel tagging queue.
  videoTrackCount Int     @default(0) @map("video_track_count")
  // Set when the best representative of this cluster is a video track rather
  // than a still. A track's crop is cut from the sharpest of several frames, so
  // it is frequently the better card image.
  repTrackId      String? @map("rep_track_id") @db.Uuid

  session          Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  faces            FaceDetection[]
  videoTracks      VideoFaceTrack[]
  suggestedSubject Subject?        @relation(fields: [suggestedSubjectId], references: [masterUserId], onDelete: SetNull)

  @@index([sessionId, tagStatus])
  @@map("face_clusters")
}

// Written at finalize. This is what links a photo to a person AND to the consent
// that permits holding it — purge/DSAR walks consentId, exactly like media_assets.
model PhotoSubject {
  id        String   @id @default(uuid()) @db.Uuid
  photoId   String   @db.Uuid
  subjectId String   @db.Uuid
  // Null ONLY on an IMPORT link for which no live ProjectConsent existed at
  // ingest. It is not "no lawful basis recorded" — the basis is recorded, as
  // SubjectDataItem.meta.lawfulBasis = 'IMPORT_UNVERIFIED', and discovery and
  // lineage surface it as such. Manufacturing a ProjectConsent row to satisfy a
  // NOT NULL would have been the opposite: a forged consent record.
  //
  // The capture path is unchanged — session.service.finalizeSession still refuses
  // to write a link without a consent id, so nothing collected can reach null here.
  consentId String?  @db.Uuid
  createdAt DateTime @default(now())

  photo   Photo           @relation(fields: [photoId], references: [id], onDelete: Cascade)
  subject Subject         @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  consent ProjectConsent? @relation(fields: [consentId], references: [consentId], onDelete: Cascade)

  @@unique([photoId, subjectId])
  @@index([consentId])
  @@map("photo_subjects")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model RecognitionJob {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @db.Uuid
  status      JobStatus @default(QUEUED)
  photosTotal Int       @default(0)
  photosDone  Int       @default(0)
  facesFound  Int       @default(0)
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("recognition_jobs")
}

enum HandoffStatus {
  PENDING_INGEST
  INGESTED
  REJECTED
}

// Emitted when a session is finalized. The batch the Consent Mapping Engine and
// the PII/Redaction Engine consume (steps 7–9 of the DSAR dataflow) — every photo
// in it already carries a consentId via photo_subjects.
model SessionHandoff {
  id           String        @id @default(uuid()) @db.Uuid
  sessionId    String        @unique @db.Uuid
  projectId    String        @db.Uuid
  status       HandoffStatus @default(PENDING_INGEST)
  photoCount   Int
  subjectCount Int
  linkCount    Int
  emittedAt    DateTime      @default(now())
  ingestedAt   DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("session_handoffs")
}

// ---------------------------------------------------------------------------
// Data-principal rights: DSAR, purge, certificates, access logging (DPDP §11–§14)
// ---------------------------------------------------------------------------

enum DsarType {
  ACCESS // §11 summary of data + processing
  CORRECT // §12(1) correction / completion
  ERASE // §12(3) erasure
  WITHDRAWAL_ERASURE // §6(4) withdrawal, auto-raised by lib/revocation.js
  GRIEVANCE // §13
  NOMINATION // §14
}

enum DsarStatus {
  RECEIVED
  TRIAGE
  DISCOVERY
  EXECUTING
  REVIEW
  CLOSED
  REJECTED
}

enum DsarChannel {
  PORTAL
  EMAIL
  PHONE
  INTERNAL
}

model DsarRequest {
  id          String      @id @default(uuid()) @db.Uuid
  subjectId   String      @map("subject_id") @db.Uuid
  projectId   String?     @map("project_id") @db.Uuid
  type        DsarType
  status      DsarStatus  @default(RECEIVED)
  channel     DsarChannel @default(PORTAL)
  description String?

  // Raised by the platform rather than the principal — a consent withdrawal walks
  // the same audited executor as a hand-filed erasure request, never a side path.
  autoRaised Boolean @default(false) @map("auto_raised")

  assignedAdminId String? @map("assigned_admin_id") @db.Uuid
  dpoAdminId      String? @map("dpo_admin_id") @db.Uuid

  // 30 days is the statutory ceiling; internalDueAt (7d) is what the SLA board
  // reports against so a breach of the real deadline is never the first warning.
  slaDueAt      DateTime  @map("sla_due_at")
  internalDueAt DateTime? @map("internal_due_at")

  // When the principal themselves pressed Erase, having reviewed the package of
  // what they are about to lose. Null means they have not, and for an ERASE
  // request that is a hard block on execution — see assertSubjectConfirmed().
  //
  // It is a timestamp rather than a boolean because "when did they agree" is the
  // question an auditor asks, and a boolean cannot answer it.
  subjectConfirmedAt DateTime? @map("subject_confirmed_at")

  resolutionNote  String?   @map("resolution_note")
  rejectionReason String?   @map("rejection_reason")
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subject     Subject              @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  evidence    DsarEvidence[]
  purgeJobs   PurgeJob[]
  certificate DeletionCertificate?
  itemActions DsarItemAction[]

  @@index([status, slaDueAt])
  @@index([subjectId, createdAt])
  @@index([assignedAdminId, status])
  // The dashboard's keyset walk: ORDER BY (sla_due_at ASC, id ASC) under a
  // `status IN (…)` tab filter. `[status, slaDueAt]` cannot serve that sort —
  // a coarse tab spans several statuses, so the planner reads every matching
  // row and sorts it. This index matches the ORDER BY exactly.
  @@index([slaDueAt, id], map: "dsar_requests_sla_due_at_id_idx")
  @@map("dsar_requests")
}

enum EvidenceKind {
  DISCOVERY_RESULT
  IDENTITY_PROOF
  EXPORT_PACKAGE
  PURGE_REPORT
  CORRESPONDENCE
  APPROVAL
}

// The audit chain stores hashes only and therefore cannot prove *what* was done.
// Anything that must be provable to a regulator lives here, in full, with its own
// hash — this table is the evidentiary record, audit_log is only tamper-evidence.
model DsarEvidence {
  id               String       @id @default(uuid()) @db.Uuid
  dsarRequestId    String       @map("dsar_request_id") @db.Uuid
  kind             EvidenceKind
  label            String
  payload          Json?
  storagePath      String?      @map("storage_path")
  contentHash      String       @map("content_hash")
  createdByAdminId String?      @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime     @default(now())

  request DsarRequest @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)

  @@index([dsarRequestId, createdAt])
  @@map("dsar_evidence")
}

enum PurgeJobStatus {
  QUEUED
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
}

// FULL is the whole-subject erasure the deletion certificate attests to. PARTIAL
// is a per-item delete raised from the DSAR item grid: it touches a named subset
// of locations, never the subject key, and is excluded from issueCertificate()
// by name. Without this column a scoped job is shaped exactly like a completed
// full erasure and would certify as one.
enum PurgeJobScope {
  FULL
  // One project's worth: everything the withdrawn consent authorised, and
  // nothing that is held per-subject. The identity row, the per-subject DEK and
  // the enrollments survive, because a §6(4) withdrawal from one project is not
  // a request to delete the account. Certifiable, but the certificate must name
  // the project rather than claim a whole-subject erasure.
  PROJECT
  PARTIAL
}

enum PurgeLocationStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED
}

// The erasure executor's unit of work. One job per DSAR, one row per physical
// location from 01_PRIVACY_DATAFLOW §2 — so a half-finished purge resumes from
// the last completed location instead of restarting and double-deleting.
model PurgeJob {
  id             String         @id @default(uuid()) @db.Uuid
  dsarRequestId  String         @map("dsar_request_id") @db.Uuid
  subjectId      String         @map("subject_id") @db.Uuid
  status         PurgeJobStatus @default(QUEUED)
  // A PARTIAL job is a scoped, per-item delete. It is never certifiable and is
  // never returned as "the open erasure" for this request.
  scope          PurgeJobScope  @default(FULL)
  // Provenance for a scoped job: which item action batch raised it, which items.
  meta           Json?
  locationsTotal Int            @default(0) @map("locations_total")
  locationsDone  Int            @default(0) @map("locations_done")
  // Set only when every location reached DONE/SKIPPED. The certificate is issued
  // off this flag, never off "the job finished running".
  keyDestroyedAt DateTime?      @map("key_destroyed_at")
  startedAt      DateTime?      @map("started_at")
  finishedAt     DateTime?      @map("finished_at")
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  request   DsarRequest        @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)
  subject   Subject            @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  locations PurgeJobLocation[]

  @@index([status])
  @@index([dsarRequestId])
  @@index([dsarRequestId, scope, status])
  @@map("purge_jobs")
}

model PurgeJobLocation {
  id           String              @id @default(uuid()) @db.Uuid
  purgeJobId   String              @map("purge_job_id") @db.Uuid
  // "L2".."L11" from the photo-lifecycle table, so the certificate can name the
  // location in the same vocabulary the DPIA uses.
  locationCode String              @map("location_code")
  objectType   String              @map("object_type")
  objectId     String?             @map("object_id")
  storagePath  String?             @map("storage_path")
  status       PurgeLocationStatus @default(PENDING)
  // Proof the thing existed and what it was, captured before deletion. After the
  // delete there is nothing left to hash — this is the only chance.
  hashBefore   String?             @map("hash_before")
  attempts     Int                 @default(0)
  error        String?
  completedAt  DateTime?           @map("completed_at")
  createdAt    DateTime            @default(now())

  job PurgeJob @relation(fields: [purgeJobId], references: [id], onDelete: Cascade)

  @@unique([purgeJobId, locationCode, objectType, objectId])
  @@index([purgeJobId, status])
  @@map("purge_job_locations")
}

// Signed, self-contained proof of erasure handed to the Data Principal. Holds its
// own canonical payload because audit_log is hash-only and cannot substitute.
model DeletionCertificate {
  id               String   @id @default(uuid()) @db.Uuid
  dsarRequestId    String   @unique @map("dsar_request_id") @db.Uuid
  purgeJobId       String?  @map("purge_job_id") @db.Uuid
  // Never the real identity: certificates are shown to DPO/auditors who have no
  // basis to see who the principal is.
  subjectPseudonym String   @map("subject_pseudonym")
  locationsCount   Int      @map("locations_count")
  payload          Json
  payloadHash      String   @map("payload_hash")
  signature        String
  signingKeyId     String   @map("signing_key_id")
  algorithm        String   @default("ed25519")
  issuedByAdminId  String?  @map("issued_by_admin_id") @db.Uuid
  completedAt      DateTime @map("completed_at")
  issuedAt         DateTime @default(now()) @map("issued_at")

  request DsarRequest @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)

  @@map("deletion_certificates")
}

enum AccessActorType {
  ADMIN
  SUBJECT
  SERVICE
}

enum AccessObjectType {
  PHOTO
  REDACTED_PHOTO
  FACE_CROP
  ENROLLMENT
  EMBEDDING
  SUBJECT_PII
  EXPORT
  DSAR_PACKAGE
  VAULT_OBJECT
  AUDIT_LOG
  // A read of the item index — "the handler enumerated everything we hold about
  // this person". Distinct from SUBJECT_PII (identity fields) because browsing a
  // person's data set and looking up their name are different intrusions.
  SUBJECT_DATA_ITEM
  // Audio. RECORDING is the raw session capture (break-glass only, same standing
  // as PHOTO); REDACTED_RECORDING is the muted derivative. The redacted route
  // shipped logging against a value that did not exist in this enum, so every
  // read of it threw at the AccessEvent write — which, because the log is
  // written before the blob is decrypted, meant the read failed closed rather
  // than leaking. Correct outcome, wrong reason.
  RECORDING
  REDACTED_RECORDING
  // Video and text, on the same terms and for the same reason. REDACTED_VIDEO
  // was already being logged by the video media route against a value this enum
  // did not have — the same failure the RECORDING comment above describes, and
  // caught the same way: fail-closed, because the AccessEvent is written before
  // the blob is decrypted.
  REDACTED_VIDEO
  TEXT_DOCUMENT
  REDACTED_TEXT_DOCUMENT
}

enum AccessAction {
  VIEW
  DOWNLOAD
  DECRYPT
  EXPORT
  DENIED
  // An identity lookup or an item enumeration. A handler trawling for a person
  // is the insider behaviour this table exists to make answerable, and scoring
  // it as VIEW would hide it among legitimate per-object reads.
  SEARCH
}

// audit_log records mutations; this records reads. DPDP §8(4) reasonable-security
// needs both, and only this one answers "who looked at this face, and why".
// Append-only by RLS: the app role may INSERT and SELECT, nothing else.
model AccessEvent {
  id            String           @id @default(uuid()) @db.Uuid
  actorType     AccessActorType  @map("actor_type")
  actorId       String?          @map("actor_id") @db.Uuid
  objectType    AccessObjectType @map("object_type")
  objectId      String           @map("object_id")
  action        AccessAction
  purpose       String?
  dsarRequestId String?          @map("dsar_request_id") @db.Uuid
  projectId     String?          @map("project_id") @db.Uuid
  ip            String?
  userAgent     String?          @map("user_agent")
  breakGlass    Boolean          @default(false) @map("break_glass")
  justification String?
  createdAt     DateTime         @default(now())

  @@index([actorId, createdAt])
  @@index([objectType, objectId])
  @@index([dsarRequestId])
  @@index([createdAt])
  @@map("access_events")
}

enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreachStatus {
  OPEN
  CONTAINED
  NOTIFIED
  CLOSED
}

// DPDP §8(5) + Rules 2025: the Data Protection Board gets a report within 72h and
// every affected principal gets told without delay. Both timestamps are columns
// so "we forgot" is a query, not an archaeology exercise.
model BreachRecord {
  id                   String         @id @default(uuid()) @db.Uuid
  title                String
  description          String
  severity             BreachSeverity
  status               BreachStatus   @default(OPEN)
  discoveredAt         DateTime       @map("discovered_at")
  containedAt          DateTime?      @map("contained_at")
  affectedSubjectCount Int            @default(0) @map("affected_subject_count")
  affectedProjectIds   Json?          @map("affected_project_ids")
  dpbNotifiedAt        DateTime?      @map("dpb_notified_at")
  principalsNotifiedAt DateTime?      @map("principals_notified_at")
  reportedByAdminId    String?        @map("reported_by_admin_id") @db.Uuid
  remediation          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status, discoveredAt])
  @@map("breach_records")
}

enum RetentionAction {
  HARD_DELETE
  CRYPTO_SHRED
  ANONYMISE
  TOMBSTONE
}

// Retention clocks from 01_PRIVACY_DATAFLOW §6.1, as data rather than constants,
// so the sweeper is one loop and a project can tighten (never loosen) a default.
model RetentionPolicy {
  id               String          @id @default(uuid()) @db.Uuid
  // null projectId = the platform default for that data class.
  projectId        String?         @map("project_id") @db.Uuid
  dataClass        String          @map("data_class")
  retentionDays    Int             @map("retention_days")
  action           RetentionAction @default(HARD_DELETE)
  clockStart       String          @map("clock_start")
  active           Boolean         @default(true)
  createdByAdminId String?         @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, dataClass])
  @@index([active])
  @@map("retention_policies")
}

// The per-subject DEK is HKDF-derived from MEDIA_KEK **and this random salt**.
// Pure HKDF(KEK, subjectId) would be unshreddable — the KEK regenerates it
// forever. Deleting the salt is what makes erasure irreversible, including in
// backups that cannot be rewritten. The row survives with salt NULL as the
// tombstone proving the key once existed and when it died.
model SubjectKey {
  subjectId   String    @id @map("subject_id") @db.Uuid
  keyId       String    @unique @map("key_id")
  salt        Bytes?
  kekVersion  Int       @default(1) @map("kek_version")
  destroyedAt DateTime? @map("destroyed_at")
  createdAt   DateTime  @default(now())

  subject Subject @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@map("subject_keys")
}

// ---------------------------------------------------------------------------
// DSAR item index — per-item discovery, actions and imports (PLAN.md phase 1)
// ---------------------------------------------------------------------------

// One value per data class the platform can hold about a person. Adding a class
// is an enum value + one resolver in itemIndex.service.js — never a new table,
// so discovery/action/export stay type-agnostic.
enum DataItemType {
  PHOTO
  // A session recording this subject is audible in. Added with its erasure path
  // in the same change as its capture path — see discovery.service.js L14/L15 and
  // purge.service.js. A capture path that reaches production ahead of its erasure
  // path makes the deletion certificate a false statement, which is the one
  // failure mode this platform cannot have.
  AUDIO
  // A session video this subject is visible in. Same rule as AUDIO: the capture
  // path (video.service.analyzeVideo) and the erasure path (purge.service L16/
  // L17 + rebuildRedactedVideoForRemaining) landed in the same change, because a
  // data class that can be collected but not erased makes the deletion
  // certificate a false statement.
  VIDEO
}

// How the item entered the system. IMPORT items have no capture-time consent
// and are flagged meta.lawfulBasis = 'IMPORT_UNVERIFIED' unless a live
// ProjectConsent was supplied; discovery surfaces that gap rather than hiding it.
enum DataItemOrigin {
  COLLECTION_SESSION
  IMPORT
  ENROLLMENT
}

// A PROJECTION, never the source of truth. The underlying photos/photo_subjects
// rows remain authoritative; this index exists so "everything we hold about this
// person" is one paged, countable query instead of a per-type fan-out. It is
// rebuildable idempotently (itemIndex.rebuildAll) precisely so a drift here can
// never become a second consistency problem on erasure-critical data.
model SubjectDataItem {
  id        String         @id @default(uuid()) @db.Uuid
  subjectId String         @map("subject_id") @db.Uuid
  type      DataItemType
  origin    DataItemOrigin

  // Polymorphic pointer back at the authoritative row.
  sourceTable String @map("source_table")
  sourceId    String @map("source_id") @db.Uuid

  projectId String? @map("project_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid

  storagePath String?   @map("storage_path")
  contentHash String?   @map("content_hash")
  capturedAt  DateTime? @map("captured_at")

  // >1 means other principals appear on the same object. A DELETE on such an
  // item is downgraded to REDACT server-side — never a client-side check.
  sharedSubjectCount Int     @default(1) @map("shared_subject_count")
  redactedAvailable  Boolean @default(false) @map("redacted_available")

  // Soft tombstone. The index keeps the row after the source is purged so the
  // DSAR timeline can still prove the item existed and was deleted.
  deletedAt DateTime? @map("deleted_at")
  indexedAt DateTime  @default(now()) @map("indexed_at")
  meta      Json?

  subject Subject          @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  actions DsarItemAction[]

  @@unique([subjectId, type, sourceTable, sourceId])
  @@index([subjectId, type, capturedAt])
  @@index([subjectId, deletedAt])
  // Phase 4's keyset walk: live items for one subject, newest first, tie-broken
  // by id. Matches the ORDER BY in itemSearch.service.js exactly.
  @@index([subjectId, deletedAt, capturedAt(sort: Desc), id(sort: Desc)], map: "subject_data_items_subject_id_deleted_at_captured_at_id_idx")
  @@map("subject_data_items")
}

enum DsarItemActionKind {
  REDACT
  DELETE
  EXPORT
}

enum DsarItemActionStatus {
  REQUESTED
  RUNNING
  DONE
  FAILED
  SKIPPED
}

// Actions are recorded before they are executed, never fire-and-forget: an
// action with no row is an action with no audit trail. The row is written in the
// request transaction as REQUESTED and moved to a terminal state by the worker.
model DsarItemAction {
  id            String               @id @default(uuid()) @db.Uuid
  dsarRequestId String               @map("dsar_request_id") @db.Uuid
  itemId        String               @map("item_id") @db.Uuid
  kind          DsarItemActionKind
  status        DsarItemActionStatus @default(REQUESTED)

  requestedByAdminId String? @map("requested_by_admin_id") @db.Uuid
  // Groups one bulk submission so a partial failure is reportable as a batch.
  batchId            String? @map("batch_id") @db.Uuid
  reason             String?
  error              String?
  // Captured before any destructive step, mirroring purge_job_locations.
  hashBefore         String? @map("hash_before")

  requestedAt DateTime  @default(now()) @map("requested_at")
  completedAt DateTime? @map("completed_at")

  request DsarRequest     @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)
  item    SubjectDataItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Idempotency: a double-submitted bulk action collapses onto one row.
  @@unique([dsarRequestId, itemId, kind])
  @@index([dsarRequestId, status])
  @@index([batchId])
  @@map("dsar_item_actions")
}

enum ImportBatchStatus {
  OPEN
  CLOSED
  FAILED
}

// An admin-initiated ingest of a named person's pre-existing data. Distinct from
// a collection session because there is no capture event, no agent and no
// capture-time consent — see DataItemOrigin.IMPORT.
model ImportBatch {
  id        String            @id @default(uuid()) @db.Uuid
  subjectId String            @map("subject_id") @db.Uuid
  type      DataItemType      @default(PHOTO)
  projectId String?           @map("project_id") @db.Uuid
  status    ImportBatchStatus @default(OPEN)

  createdByAdminId String? @map("created_by_admin_id") @db.Uuid

  itemsTotal  Int @default(0) @map("items_total")
  itemsDone   Int @default(0) @map("items_done")
  itemsFailed Int @default(0) @map("items_failed")

  note      String?
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  subject Subject  @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([subjectId, createdAt])
  @@index([status])
  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// Audio capture (L14 original / L15 redacted derivative)
// ---------------------------------------------------------------------------

enum RecordingStatus {
  PENDING_ANALYSIS
  ANALYZED
  REDACTED
  // Fail-closed, exactly as PiiStatus.DEFERRED is for images: the worker was
  // unreachable or errored, so the recording has NOT been cleared and its
  // derivative must not be served or handed off.
  DEFERRED
}

enum AudioSegmentAction {
  KEEP
  REDACT_VOICE
  REDACT_PII
}

enum TextDocumentStatus {
  PENDING_ANALYSIS
  TAGGED
  REDACTED
  // Same meaning as on Recording: the text service could not be reached, so
  // nothing here has been checked. Never collapsed into PENDING_ANALYSIS —
  // "we could not check" must not read as "there was nothing to redact".
  DEFERRED
}

enum TextSpanAction {
  KEEP_NON_PII
  REDACT_ALL
  REDACT_PII
  // The agent's own overrides, kept distinct from the detector's actions so an
  // export or an audit can always say whether a person or the pipeline decided.
  MANUAL_REDACT
  MANUAL_UNREDACT
}

// A session recording. Deliberately shaped like Photo — same integrity columns
// (sha256/sizeBytes/mimeType), same encKeyId so a key rotation knows what sealed
// it, same fail-closed status. A recording that does not carry these cannot be
// hashed before destruction, which is what a deletion certificate attests to.
model Recording {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  storagePath  String  @map("storage_path")
  // Bystander-muted derivative. The original is never overwritten — same rule as
  // Photo.redactedPath.
  redactedPath String? @map("redacted_path")

  mimeType    String @default("audio/wav") @map("mime_type")
  sha256      String @default("")
  sizeBytes   Int    @default(0) @map("size_bytes")
  durationSec Float? @map("duration_sec")

  status RecordingStatus @default(PENDING_ANALYSIS)

  // keyId of the DEK that sealed storagePath / redactedPath. null = plaintext
  // legacy blob. Mirrors Photo.encKeyId.
  encKeyId String? @map("enc_key_id")

  createdAt DateTime @default(now()) @map("created_at")

  session  Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  segments AudioSegment[]

  @@index([sessionId])
  @@index([status])
  @@map("recordings")
}

// One diarised utterance, or one PII span. This is the audio analogue of
// PhotoSubject: `subjectId` is the erasure key, and it carries a real FK so a
// subject cascade reaches it instead of leaving orphaned voice attributions.
model AudioSegment {
  id          String @id @default(uuid()) @db.Uuid
  recordingId String @map("recording_id") @db.Uuid

  // The diarizer's within-file speaker slot ("SPEAKER_00"). Meaningless across
  // recordings — only `subjectId` identifies a person.
  speakerId String  @map("speaker_id")
  subjectId String? @map("subject_id") @db.Uuid

  // Null ONLY where no live ProjectConsent existed at analysis time, exactly as
  // PhotoSubject.consentId is. A KEEP segment must always carry one.
  consentId String? @map("consent_id") @db.Uuid

  startSec Float @map("start_sec")
  endSec   Float @map("end_sec")

  action AudioSegmentAction
  // Why this segment got its action, in the row itself. The timeline shows it
  // verbatim next to every muted span: "matched someone whose consent does not
  // cover this" and "matched nobody at all" are the two outcomes an agent most
  // needs told apart, and they are identical in `action` alone.
  reason  String?
  piiType String? @map("pii_type")

  matchScore Float? @map("match_score")

  recording Recording       @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  subject   Subject?        @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  consent   ProjectConsent? @relation(fields: [consentId], references: [consentId], onDelete: SetNull)

  @@index([recordingId])
  // The DSAR discovery probe: every recording this person is audible in.
  @@index([subjectId])
  @@index([consentId])
  @@map("audio_segments")
}

// ---------------------------------------------------------------------------
// Video capture (L16 original / L17 redacted derivative / L18 track crop)
// ---------------------------------------------------------------------------

enum VideoStatus {
  PENDING_ANALYSIS
  ANALYZED
  REDACTED
  // Fail-closed, identical in meaning to RecordingStatus.DEFERRED and
  // PiiStatus.DEFERRED: the worker was unreachable or errored, so this clip has
  // NOT been cleared. No derivative may be served and the handoff must not
  // ingest the batch until a retry clears it.
  DEFERRED
}

// A session video. Deliberately shaped like Recording, which is itself shaped
// like Photo — same integrity columns (sha256/sizeBytes/mimeType), same encKeyId
// so a key rotation knows what sealed it, same fail-closed status. A clip that
// does not carry these cannot be hashed before destruction, which is what a
// deletion certificate attests to.
//
// Video is NOT modelled as many Photo rows. Beyond the cost, a 2-minute clip
// would become ~3,600 rows and the DSAR item grid would tell a principal we hold
// three thousand photographs of them, which is false in the way that matters.
model VideoAsset {
  id        String  @id @default(uuid()) @db.Uuid
  // Nullable for the same reason Photo.sessionId is: an imported clip has no
  // capture event, therefore no session, agent or project to hang one on.
  sessionId String? @map("session_id") @db.Uuid

  storagePath  String  @map("storage_path")
  // Bystander-blurred derivative. The original at storagePath is never
  // overwritten — same rule as Photo.redactedPath and Recording.redactedPath.
  redactedPath String? @map("redacted_path")
  // The detection-overlay derivative: boxes and track labels drawn over the
  // frames, with nothing masked. It exists so an operator can see what the
  // detector found BEFORE tagging, which is the only point at which a
  // mis-grouped track can still be corrected.
  //
  // Every face in it is legible, so it is NOT a redacted derivative and must
  // never be served under the rules that govern one — it follows storagePath's
  // access rules, not redactedPath's. It is also deleted alongside the original
  // (L20), never alongside the blurred copy.
  detectedPath String? @map("detected_path")

  mimeType  String @default("video/mp4") @map("mime_type")
  sha256    String @default("")
  sizeBytes Int    @default(0) @map("size_bytes")

  durationSec Float? @map("duration_sec")
  fps         Float?
  width       Int?
  height      Int?
  frameCount  Int?   @default(0) @map("frame_count")

  status VideoStatus @default(PENDING_ANALYSIS)
  // Tracked separately from `status` for the same reason Photo has both a
  // redactedPath and a piiStatus: "faces were handled" and "printed text was
  // handled" are different claims, and an outage in the PII detector must not
  // be reported as a clean clip.
  piiStatus PiiStatus @default(PENDING) @map("pii_status")

  // keyId of the DEK that sealed storagePath / redactedPath. Mirrors
  // Photo.encKeyId and Recording.encKeyId.
  encKeyId String? @map("enc_key_id")

  createdAt DateTime @default(now()) @map("created_at")

  session  Session?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tracks   VideoFaceTrack[]
  piiSpans VideoPiiSpan[]
  subjects VideoSubject[]

  @@unique([sessionId, sha256])
  @@index([sessionId])
  @@index([status])
  @@map("video_assets")
}

// One person's continuous appearance in a clip — the temporal analogue of
// FaceDetection, and the unit an agent tags.
//
// Face embeddings are NEVER persisted here, exactly as they are not on
// FaceDetection. The worker returns one averaged vector per track, the
// recognition pass clusters and matches with it in memory, and drops it. Only
// the boxes, the crop, and (once tagged) the subject link survive.
model VideoFaceTrack {
  id      String  @id @default(uuid()) @db.Uuid
  videoId String  @map("video_id") @db.Uuid
  // Points at the SAME FaceCluster a photo face would. One card per person per
  // session, covering both media.
  clusterId String? @map("cluster_id") @db.Uuid

  // The worker's within-clip track slot ("t0"). Meaningless across clips — only
  // taggedSubjectId identifies a person.
  trackId String @map("track_id")

  startFrame Int   @map("start_frame")
  endFrame   Int   @map("end_frame")
  startSec   Float @map("start_sec")
  endSec     Float @map("end_sec")

  // Keyframed boxes: [{frame,x1,y1,x2,y2}, ...] at the detection stride. The
  // redactor interpolates between them and holds past the ends. Storing every
  // frame's box instead would be ~3,600 rows per person per clip to describe a
  // path that is smooth by construction.
  boxes Json

  detScore Float? @map("det_score")
  // Whether this track's vector could be computed at all. 0 means no frame was
  // embeddable, which the match step must read as "not identifiable" — never as
  // "no match", which would be indistinguishable from a confident rejection.
  embeddedFrames Int @default(0) @map("embedded_frames")

  repFrame Int?    @map("rep_frame")
  cropPath String? @map("crop_path")

  taggedSubjectId String?       @db.Uuid @map("tagged_subject_id")
  tagStatus       FaceTagStatus @default(PENDING) @map("tag_status")

  createdAt DateTime @default(now()) @map("created_at")

  video         VideoAsset   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  cluster       FaceCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  taggedSubject Subject?     @relation(fields: [taggedSubjectId], references: [masterUserId], onDelete: SetNull)

  @@index([videoId])
  @@index([clusterId])
  @@map("video_face_tracks")
}

// A run of frames over which sensitive printed text was visible.
//
// Carries no subjectId and no consentId, deliberately: printed PII is masked
// whoever is holding it. That is the same rule the stills path applies (text
// masking is not gated on biometric consent) and the audio path applies to
// REDACT_PII spans.
model VideoPiiSpan {
  id      String @id @default(uuid()) @db.Uuid
  videoId String @map("video_id") @db.Uuid

  startFrame Int   @map("start_frame")
  endFrame   Int   @map("end_frame")
  startSec   Float @map("start_sec")
  endSec     Float @map("end_sec")

  boxes Json
  kind  String @default("TEXT")

  video VideoAsset @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("video_pii_spans")
}

// Written at finalize. Links a clip to a person AND to the consent that permits
// holding it — purge/DSAR walks consentId, exactly like photo_subjects and
// audio_segments. This is the erasure key for video.
model VideoSubject {
  id        String @id @default(uuid()) @db.Uuid
  videoId   String @map("video_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  // Null ONLY on an import link for which no live ProjectConsent existed at
  // ingest, matching PhotoSubject.consentId. The capture path never writes null:
  // finalizeSession refuses to create a link without a consent id.
  consentId String? @map("consent_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  video   VideoAsset      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  subject Subject         @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  consent ProjectConsent? @relation(fields: [consentId], references: [consentId], onDelete: Cascade)

  @@unique([videoId, subjectId])
  @@index([subjectId])
  @@index([consentId])
  @@map("video_subjects")
}

// ---------------------------------------------------------------------------
// Text documents (L18) and their spans. Shaped like Recording/AudioSegment for
// the same reasons: the same integrity columns (sha256/mimeType), the same
// encKeyId so a key rotation knows what sealed it, the same fail-closed status,
// and attribution carried on the spans rather than on the document — a document
// naming several people is not "about" any one of them.
// ---------------------------------------------------------------------------

model TextDocument {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  name String @default("Untitled Document")

  storagePath  String  @map("storage_path")
  redactedPath String? @map("redacted_path")

  status   TextDocumentStatus @default(PENDING_ANALYSIS)
  mimeType String?            @default("text/plain") @map("mime_type")
  sha256   String?
  charCount Int?              @default(0) @map("char_count")
  encKeyId String?            @map("enc_key_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  spans   TextSpan[]

  @@index([sessionId])
  @@map("text_documents")
}

model TextSpan {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  subjectId String? @map("subject_id") @db.Uuid
  // Null ONLY where no live ProjectConsent existed at analysis time, exactly as
  // AudioSegment.consentId is. A KEEP_NON_PII span must always carry one.
  consentId String? @map("consent_id") @db.Uuid

  startChar Int @map("start_char")
  endChar   Int @map("end_char")

  action      TextSpanAction @default(KEEP_NON_PII)
  reason      String?
  piiType     String?        @map("pii_type")
  textSnippet String?        @map("text_snippet")

  document TextDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  subject  Subject?        @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  consent  ProjectConsent? @relation(fields: [consentId], references: [consentId], onDelete: SetNull)

  @@index([documentId])
  // The DSAR discovery probe: every document this person is named in.
  @@index([subjectId])
  @@index([consentId])
  @@map("text_spans")
}


// ---------------------------------------------------------------------------
// Blob lifecycle
// ---------------------------------------------------------------------------

enum OrphanBlobState {
  // Found on disk with no row referencing it, or a delete that failed. Not yet
  // touched.
  PENDING_DELETE
  // Moved out of the media root into the quarantine prefix. Recoverable.
  QUARANTINED
  // Shredded. The row survives as the record that it was.
  DELETED
  // A human looked and said keep it. Excluded from every future sweep.
  RETAINED
}

/// A file under the media root that no database row points at.
///
/// This table exists because 83% of the media store was in that state — 1,123
/// files, 265 MB, including 383 cropped faces and 135 enrolment selfies — and
/// both DSAR discovery and purge enumerate blobs by walking rows, so every one
/// of them was invisible to discovery and unreachable by erasure. A signed
/// deletion certificate could therefore attest to an erasure that left 518
/// biometric files on disk.
///
/// The reaper never hard-deletes on first sight. It quarantines, waits out a
/// grace period, and only then shreds — because the one thing worse than an
/// orphan is deleting a file that a row written moments later would have
/// referenced.
model OrphanBlob {
  id          String          @id @default(uuid()) @db.Uuid
  storagePath String          @unique @map("storage_path")
  sizeBytes   BigInt?         @map("size_bytes")
  /// Why it is here: DELETE_FAILED, SWEEP_UNREFERENCED, RECOGNITION_RERUN, ...
  reason      String
  state       OrphanBlobState @default(PENDING_DELETE)
  /// Where it was moved to when quarantined, so it can be put back.
  quarantinePath String?      @map("quarantine_path")
  firstSeenAt DateTime        @default(now()) @map("first_seen_at")
  quarantinedAt DateTime?     @map("quarantined_at")
  resolvedAt  DateTime?       @map("resolved_at")
  /// Set when a human chose RETAINED, so the decision has a name against it.
  decidedByAdminId String?    @db.Uuid @map("decided_by_admin_id")

  @@index([state, firstSeenAt])
  @@map("orphan_blobs")
}

enum StalledJobState {
  DETECTED
  REQUEUED
  FAILED_PERMANENTLY
  RESOLVED
}

/// One row per job the reaper found stuck.
///
/// The pipeline had no reaper, no stalled-job timeout surfaced anywhere, and no
/// screen that showed it: session COL-7224 sat PROCESSING for two days and the
/// oldest PENDING photo for sixteen, with nothing reporting either. This table
/// is what the operator queue-health screen reads, and it is deliberately
/// persistent rather than a Redis key — "what got stuck and what did we do about
/// it" is an operational record, not cache.
model StalledJob {
  id         String          @id @default(uuid()) @db.Uuid
  queueName  String          @map("queue_name")
  jobId      String          @map("job_id")
  /// The session, photo or subject the job was about, for the operator screen.
  subjectRef String?         @map("subject_ref")
  state      StalledJobState @default(DETECTED)
  stalledForMs BigInt?       @map("stalled_for_ms")
  attempts   Int             @default(0)
  lastError  String?         @map("last_error")
  detectedAt DateTime        @default(now()) @map("detected_at")
  resolvedAt DateTime?       @map("resolved_at")

  @@unique([queueName, jobId])
  @@index([state, detectedAt])
  @@map("stalled_jobs")
}

// ---------------------------------------------------------------------------
// Project export
// ---------------------------------------------------------------------------

enum ProjectExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

/// A whole-project download.
///
/// This did not exist — not the route, not the button. All 156 route definitions
/// were enumerated: the complete project surface was GET/POST /projects, GET and
/// PATCH /:projectId, four lifecycle POSTs, and GET /:projectId/{assignments,
/// sessions,handoffs,report}, where /report returns 765 bytes of JSON counts. No
/// route in the application returned project-scoped media or an archive, and
/// ProcessedData.jsx — the Data Owner's "finished data" screen — had no download
/// control anywhere on it.
///
/// It is a row rather than a synchronous response because of the volumes: at the
/// measured 241.3 KB average image and the 5,000/day target, a project archive
/// passes 4 GiB in three and a half days of collection. A request that has to
/// stay open for that is a request that will not survive a load balancer, and
/// building it in the API process's heap first is what took the whole API down.
model ProjectExport {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @map("project_id") @db.Uuid
  /// The dataOwner who asked. Never null — an export with no requester is an
  /// export nobody is accountable for.
  requestedByAdminId String     @map("requested_by_admin_id") @db.Uuid
  status    ProjectExportStatus @default(QUEUED)

  /// REDACTED_DERIVATIVES is the only value this ships with. The column exists
  /// so that an originals path, if ever built, is a new value here rather than a
  /// flag someone flips on the existing one.
  scope     String              @default("REDACTED_DERIVATIVES")

  photosTotal    Int    @default(0) @map("photos_total")
  photosWritten  Int    @default(0) @map("photos_written")
  /// Excluded because consent was revoked or expired at build time, counted so
  /// the manifest can state it rather than silently shipping less.
  photosExcluded Int    @default(0) @map("photos_excluded")
  subjectCount   Int    @default(0) @map("subject_count")

  sizeBytes   BigInt? @map("size_bytes")
  storagePath String? @map("storage_path")
  contentHash String? @map("content_hash")

  error     String?
  createdAt DateTime  @default(now()) @map("created_at")
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// Packages are personal data with a retention clock of their own. An export
  /// built before an erasure still contains the erased subject, so it must not
  /// outlive its purpose.
  expiresAt DateTime? @map("expires_at")
  downloadCount Int   @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at")

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy    AdminUser @relation(fields: [requestedByAdminId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([status])
  @@map("project_exports")
}
