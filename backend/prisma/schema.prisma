generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, uuid_ossp(map: "uuid-ossp")]
}

model Subject {
  masterUserId        String                  @id @default(uuid()) @map("master_user_id") @db.Uuid
  group               SubjectGroup
  status              SubjectStatus           @default(PENDING)
  fullName            String
  email               String                  @unique @db.Citext
  phone               String?
  employeeRef         String?                 @unique
  registrationChannel RegistrationChannel
  registeredByUserId  String?                 @db.Uuid
  otpVerifiedAt       DateTime?
  generalTerms        Boolean                 @default(false)
  piiProcessing       Boolean                 @default(false)
  biometricMatch      Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  dateOfBirth         DateTime?               @map("date_of_birth") @db.Date
  guardianContact     String?                 @map("guardian_contact")
  nomineeContact      String?                 @map("nominee_contact")
  dsarRequests        DsarRequest[]
  suggestedClusters   FaceCluster[]
  taggedFaces         FaceDetection[]
  import_batches      import_batches[]
  photoLinks          PhotoSubject[]
  projectConsents     ProjectConsent[]
  purgeJobs           PurgeJob[]
  refreshTokens       RefreshToken[]
  sessionParticipants SessionParticipant[]
  subject_data_items  subject_data_items[]
  faceEnrollments     SubjectFaceEnrollment[]
  subjectKey          SubjectKey?

  @@index([group, status])
  @@index([employeeRef])
  @@map("data_subjects")
}

model SubjectFaceEnrollment {
  id           String           @id @default(uuid()) @db.Uuid
  subjectId    String           @map("subject_id") @db.Uuid
  imagePath    String
  sha256       String
  detScore     Float
  width        Int?
  height       Int?
  source       EnrollmentSource
  capturedBy   String?          @db.Uuid
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  pose         EnrollmentPose?
  embedding    Bytes?
  embeddingDim Int?
  encKeyId     String?          @map("enc_key_id")
  subject      Subject          @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@unique([subjectId, sha256])
  @@index([subjectId, deletedAt])
  @@map("subject_face_enrollments")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String
  entityId      String   @db.Uuid
  action        String
  actorId       String?  @db.Uuid
  payloadHash   String
  prevHash      String?
  createdAt     DateTime @default(now())
  payloadDigest String?  @map("payload_digest")

  @@index([entityType, entityId, createdAt])
  @@map("audit_log")
}

model AdminUser {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique @db.Citext
  passwordHash        String?
  role                AdminRole
  status              AdminStatus         @default(INVITED)
  invitedByAdminId    String?             @db.Uuid
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  authTokens          AuthToken[]
  projectAssignments  ProjectAssignment[]
  ownedProjects       Project[]
  refreshTokens       RefreshToken[]
  sessions            Session[]

  @@index([role, status])
  @@map("admin_users")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @db.Citext
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([email, purpose, consumedAt])
  @@map("otp_codes")
}

model AuthToken {
  id          String           @id @default(uuid()) @db.Uuid
  adminUserId String           @db.Uuid
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())
  admin       AdminUser        @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model RefreshToken {
  id          String     @id @default(uuid()) @db.Uuid
  subjectId   String?    @db.Uuid
  adminUserId String?    @db.Uuid
  familyId    String     @db.Uuid
  tokenHash   String     @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  subject     Subject?   @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@index([subjectId])
  @@index([adminUserId])
  @@map("refresh_tokens")
}

model Project {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  purpose           String
  policyVersion     String              @default("v1")
  status            ProjectStatus       @default(DRAFT)
  ownerAdminId      String?             @db.Uuid
  retention         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedAt        DateTime?           @map("approved_at")
  approvedByAdminId String?             @map("approved_by_admin_id") @db.Uuid
  consentTemplateId String?             @map("consent_template_id") @db.Uuid
  dataTypes         Json?               @map("data_types")
  rejectionReason   String?             @map("rejection_reason")
  riskLevel         RiskLevel?          @map("risk_level")
  submittedAt       DateTime?           @map("submitted_at")
  dsarRequests      DsarRequest[]
  import_batches    import_batches[]
  assignments       ProjectAssignment[]
  consents          ProjectConsent[]
  consentTemplate   ConsentTemplate?    @relation(fields: [consentTemplateId], references: [id])
  owner             AdminUser?          @relation(fields: [ownerAdminId], references: [id])
  retentionPolicies RetentionPolicy[]
  sessions          Session[]

  @@index([status])
  @@index([ownerAdminId])
  @@map("projects")
}

model ConsentTemplate {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  version          Int                   @default(1)
  status           ConsentTemplateStatus @default(DRAFT)
  purpose          String
  bodyByLocale     Json                  @map("body_by_locale")
  dataTypes        Json?                 @map("data_types")
  retention        String?
  grievanceContact String?               @map("grievance_contact")
  supersedesId     String?               @map("supersedes_id") @db.Uuid
  createdByAdminId String?               @map("created_by_admin_id") @db.Uuid
  publishedAt      DateTime?             @map("published_at")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  supersedes       ConsentTemplate?      @relation("TemplateVersions", fields: [supersedesId], references: [id])
  supersededBy     ConsentTemplate[]     @relation("TemplateVersions")
  projects         Project[]

  @@unique([name, version])
  @@index([status])
  @@map("consent_templates")
}

model ProjectAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  adminId    String    @db.Uuid
  assignedAt DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, adminId])
  @@index([adminId])
  @@map("project_assignments")
}

model ProjectConsent {
  consentId           String               @id @default(uuid()) @db.Uuid
  subjectId           String               @db.Uuid
  projectId           String               @db.Uuid
  status              ConsentStatus        @default(ACTIVE)
  policyVersion       String
  signatureHash       String
  consentedAt         DateTime             @default(now())
  revokedAt           DateTime?
  photos              PhotoSubject[]
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject             Subject              @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  sessionParticipants SessionParticipant[]
  audioSegments       AudioSegment[]
  textSpans           TextSpan[]

  @@unique([subjectId, projectId])
  @@index([projectId, status])
  @@map("project_consent_matrix")
}

model Session {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique
  projectId    String               @db.Uuid
  agentId      String               @db.Uuid
  type         SessionType          @default(IMAGE) @map("type")
  status       SessionStatus        @default(ACTIVE)
  location     String?
  createdAt    DateTime             @default(now())
  endedAt      DateTime?
  archivedAt   DateTime?
  recordings   Recording[]
  documents    TextDocument[]
  clusters     FaceCluster[]
  photos       Photo[]
  jobs         RecognitionJob[]
  handoff      SessionHandoff?
  invites      SessionInvite[]
  participants SessionParticipant[]
  agent        AdminUser            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([projectId])
  @@map("sessions")
}


model SessionInvite {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdBy String    @db.Uuid
  createdAt DateTime  @default(now())
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_invites")
}

model SessionParticipant {
  id        String         @id @default(uuid()) @db.Uuid
  sessionId String         @db.Uuid
  subjectId String         @db.Uuid
  consentId String         @db.Uuid
  addedAt   DateTime       @default(now())
  consent   ProjectConsent @relation(fields: [consentId], references: [consentId], onDelete: Cascade)
  session   Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@unique([sessionId, subjectId])
  @@map("session_participants")
}

model Photo {
  id           String          @id @default(uuid()) @db.Uuid
  sessionId    String?         @db.Uuid
  storagePath  String
  cameraSource CameraSource
  sha256       String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  takenAt      DateTime?
  createdAt    DateTime        @default(now())
  redactedPath String?         @map("redacted_path")
  encKeyId     String?         @map("enc_key_id")
  piiStatus    PiiStatus       @default(PENDING) @map("pii_status")
  faces        FaceDetection[]
  subjects     PhotoSubject[]
  session      Session?        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sha256])
  @@index([sessionId])
  @@index([sha256])
  @@map("photos")
}

model FaceDetection {
  id              String        @id @default(uuid()) @db.Uuid
  photoId         String        @db.Uuid
  clusterId       String?       @db.Uuid
  bbox            Json
  detScore        Float?
  cropPath        String?
  taggedSubjectId String?       @db.Uuid
  tagStatus       FaceTagStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  cluster         FaceCluster?  @relation(fields: [clusterId], references: [id])
  photo           Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)
  taggedSubject   Subject?      @relation(fields: [taggedSubjectId], references: [masterUserId])

  @@index([photoId])
  @@index([clusterId])
  @@map("face_detections")
}

model FaceCluster {
  id                 String          @id @default(uuid()) @db.Uuid
  sessionId          String          @db.Uuid
  repFaceId          String?         @db.Uuid
  faceCount          Int             @default(0)
  suggestedSubjectId String?         @db.Uuid
  tagStatus          FaceTagStatus   @default(PENDING)
  taggedSubjectId    String?         @db.Uuid
  createdAt          DateTime        @default(now())
  matchScore         Float?          @map("match_score")
  autoTagged         Boolean         @default(false) @map("auto_tagged")
  videoTrackCount    Int?            @default(0) @map("video_track_count")
  session            Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  suggestedSubject   Subject?        @relation(fields: [suggestedSubjectId], references: [masterUserId])
  faces              FaceDetection[]

  @@index([sessionId, tagStatus])
  @@map("face_clusters")
}

model PhotoSubject {
  id        String          @id @default(uuid()) @db.Uuid
  photoId   String          @db.Uuid
  subjectId String          @db.Uuid
  consentId String?         @db.Uuid
  createdAt DateTime        @default(now())
  consent   ProjectConsent? @relation(fields: [consentId], references: [consentId], onDelete: Cascade)
  photo     Photo           @relation(fields: [photoId], references: [id], onDelete: Cascade)
  subject   Subject         @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@unique([photoId, subjectId])
  @@index([consentId])
  @@map("photo_subjects")
}

model RecognitionJob {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @db.Uuid
  status      JobStatus @default(QUEUED)
  photosTotal Int       @default(0)
  photosDone  Int       @default(0)
  facesFound  Int       @default(0)
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("recognition_jobs")
}

model SessionHandoff {
  id           String        @id @default(uuid()) @db.Uuid
  sessionId    String        @unique @db.Uuid
  projectId    String        @db.Uuid
  status       HandoffStatus @default(PENDING_INGEST)
  photoCount   Int
  subjectCount Int
  linkCount    Int
  emittedAt    DateTime      @default(now())
  ingestedAt   DateTime?
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("session_handoffs")
}

model DsarRequest {
  id                String               @id @default(uuid()) @db.Uuid
  subjectId         String               @map("subject_id") @db.Uuid
  projectId         String?              @map("project_id") @db.Uuid
  type              DsarType
  status            DsarStatus           @default(RECEIVED)
  channel           DsarChannel          @default(PORTAL)
  description       String?
  autoRaised        Boolean              @default(false) @map("auto_raised")
  assignedAdminId   String?              @map("assigned_admin_id") @db.Uuid
  dpoAdminId        String?              @map("dpo_admin_id") @db.Uuid
  slaDueAt          DateTime             @map("sla_due_at")
  internalDueAt     DateTime?            @map("internal_due_at")
  resolutionNote    String?              @map("resolution_note")
  rejectionReason   String?              @map("rejection_reason")
  closedAt          DateTime?            @map("closed_at")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  certificate       DeletionCertificate?
  evidence          DsarEvidence[]
  dsar_item_actions dsar_item_actions[]
  project           Project?             @relation(fields: [projectId], references: [id])
  subject           Subject              @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)
  purgeJobs         PurgeJob[]

  @@index([status, slaDueAt])
  @@index([subjectId, createdAt])
  @@index([assignedAdminId, status])
  @@index([slaDueAt, id])
  @@map("dsar_requests")
}

model DsarEvidence {
  id               String       @id @default(uuid()) @db.Uuid
  dsarRequestId    String       @map("dsar_request_id") @db.Uuid
  kind             EvidenceKind
  label            String
  payload          Json?
  storagePath      String?      @map("storage_path")
  contentHash      String       @map("content_hash")
  createdByAdminId String?      @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime     @default(now())
  request          DsarRequest  @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)

  @@index([dsarRequestId, createdAt])
  @@map("dsar_evidence")
}

model PurgeJob {
  id             String             @id @default(uuid()) @db.Uuid
  dsarRequestId  String             @map("dsar_request_id") @db.Uuid
  subjectId      String             @map("subject_id") @db.Uuid
  status         PurgeJobStatus     @default(QUEUED)
  locationsTotal Int                @default(0) @map("locations_total")
  locationsDone  Int                @default(0) @map("locations_done")
  keyDestroyedAt DateTime?          @map("key_destroyed_at")
  startedAt      DateTime?          @map("started_at")
  finishedAt     DateTime?          @map("finished_at")
  error          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  scope          PurgeJobScope      @default(FULL)
  meta           Json?
  locations      PurgeJobLocation[]
  request        DsarRequest        @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)
  subject        Subject            @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@index([status])
  @@index([dsarRequestId])
  @@index([dsarRequestId, scope, status])
  @@map("purge_jobs")
}

model PurgeJobLocation {
  id           String              @id @default(uuid()) @db.Uuid
  purgeJobId   String              @map("purge_job_id") @db.Uuid
  locationCode String              @map("location_code")
  objectType   String              @map("object_type")
  objectId     String?             @map("object_id")
  storagePath  String?             @map("storage_path")
  status       PurgeLocationStatus @default(PENDING)
  hashBefore   String?             @map("hash_before")
  attempts     Int                 @default(0)
  error        String?
  completedAt  DateTime?           @map("completed_at")
  createdAt    DateTime            @default(now())
  job          PurgeJob            @relation(fields: [purgeJobId], references: [id], onDelete: Cascade)

  @@unique([purgeJobId, locationCode, objectType, objectId])
  @@index([purgeJobId, status])
  @@map("purge_job_locations")
}

model DeletionCertificate {
  id               String      @id @default(uuid()) @db.Uuid
  dsarRequestId    String      @unique @map("dsar_request_id") @db.Uuid
  purgeJobId       String?     @map("purge_job_id") @db.Uuid
  subjectPseudonym String      @map("subject_pseudonym")
  locationsCount   Int         @map("locations_count")
  payload          Json
  payloadHash      String      @map("payload_hash")
  signature        String
  signingKeyId     String      @map("signing_key_id")
  algorithm        String      @default("ed25519")
  issuedByAdminId  String?     @map("issued_by_admin_id") @db.Uuid
  completedAt      DateTime    @map("completed_at")
  issuedAt         DateTime    @default(now()) @map("issued_at")
  request          DsarRequest @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)

  @@map("deletion_certificates")
}

model AccessEvent {
  id            String           @id @default(uuid()) @db.Uuid
  actorType     AccessActorType  @map("actor_type")
  actorId       String?          @map("actor_id") @db.Uuid
  objectType    AccessObjectType @map("object_type")
  objectId      String           @map("object_id")
  action        AccessAction
  purpose       String?
  dsarRequestId String?          @map("dsar_request_id") @db.Uuid
  projectId     String?          @map("project_id") @db.Uuid
  ip            String?
  userAgent     String?          @map("user_agent")
  breakGlass    Boolean          @default(false) @map("break_glass")
  justification String?
  createdAt     DateTime         @default(now())

  @@index([actorId, createdAt])
  @@index([objectType, objectId])
  @@index([dsarRequestId])
  @@index([createdAt])
  @@map("access_events")
}

model BreachRecord {
  id                   String         @id @default(uuid()) @db.Uuid
  title                String
  description          String
  severity             BreachSeverity
  status               BreachStatus   @default(OPEN)
  discoveredAt         DateTime       @map("discovered_at")
  containedAt          DateTime?      @map("contained_at")
  affectedSubjectCount Int            @default(0) @map("affected_subject_count")
  affectedProjectIds   Json?          @map("affected_project_ids")
  dpbNotifiedAt        DateTime?      @map("dpb_notified_at")
  principalsNotifiedAt DateTime?      @map("principals_notified_at")
  reportedByAdminId    String?        @map("reported_by_admin_id") @db.Uuid
  remediation          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status, discoveredAt])
  @@map("breach_records")
}

model RetentionPolicy {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String?         @map("project_id") @db.Uuid
  dataClass        String          @map("data_class")
  retentionDays    Int             @map("retention_days")
  action           RetentionAction @default(HARD_DELETE)
  clockStart       String          @map("clock_start")
  active           Boolean         @default(true)
  createdByAdminId String?         @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, dataClass])
  @@index([active])
  @@map("retention_policies")
}

model SubjectKey {
  subjectId   String    @id @map("subject_id") @db.Uuid
  keyId       String    @unique @map("key_id")
  salt        Bytes?
  kekVersion  Int       @default(1) @map("kek_version")
  destroyedAt DateTime? @map("destroyed_at")
  createdAt   DateTime  @default(now())
  subject     Subject   @relation(fields: [subjectId], references: [masterUserId], onDelete: Cascade)

  @@map("subject_keys")
}

model Recording {
  id           String          @id @default(uuid()) @db.Uuid
  sessionId    String          @map("session_id") @db.Uuid
  storagePath  String          @map("storage_path")
  redactedPath String?         @map("redacted_path")
  status       RecordingStatus @default(PENDING_ANALYSIS)
  mimeType     String?         @map("mime_type")
  sha256       String?
  sizeBytes    Int?            @map("size_bytes")
  durationSec  Float?          @map("duration_sec")
  encKeyId     String?         @map("enc_key_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  segments     AudioSegment[]
  session      Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("recordings")
}

model AudioSegment {
  id          String             @id @default(uuid()) @db.Uuid
  recordingId String             @map("recording_id") @db.Uuid
  speakerId   String             @map("speaker_id")
  subjectId   String?            @map("subject_id") @db.Uuid
  consentId   String?            @map("consent_id") @db.Uuid
  startSec    Float              @map("start_sec")
  endSec      Float              @map("end_sec")
  action      AudioSegmentAction
  reason      String?
  piiType     String?            @map("pii_type")
  matchScore  Float?             @map("match_score")
  recording   Recording          @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  consent     ProjectConsent?    @relation(fields: [consentId], references: [consentId], onDelete: SetNull)

  @@index([recordingId])
  @@index([subjectId])
  @@index([consentId])
  @@map("audio_segments")
}

model TextDocument {
  id           String             @id @default(uuid()) @db.Uuid
  sessionId    String             @map("session_id") @db.Uuid
  name         String             @default("Untitled Document")
  storagePath  String             @map("storage_path")
  redactedPath String?            @map("redacted_path")
  status       TextDocumentStatus @default(PENDING_ANALYSIS)
  mimeType     String?            @default("text/plain") @map("mime_type")
  sha256       String?
  charCount    Int?               @default(0) @map("char_count")
  encKeyId     String?            @map("enc_key_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  spans        TextSpan[]
  session      Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("text_documents")
}

model TextSpan {
  id          String          @id @default(uuid()) @db.Uuid
  documentId  String          @map("document_id") @db.Uuid
  subjectId   String?         @map("subject_id") @db.Uuid
  consentId   String?         @map("consent_id") @db.Uuid
  startChar   Int             @map("start_char")
  endChar     Int             @map("end_char")
  action      TextSpanAction  @default(KEEP_NON_PII)
  reason      String?
  piiType     String?         @map("pii_type")
  textSnippet String?         @map("text_snippet")
  document    TextDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  consent     ProjectConsent? @relation(fields: [consentId], references: [consentId], onDelete: SetNull)

  @@index([documentId])
  @@index([subjectId])
  @@index([consentId])
  @@map("text_spans")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dsar_item_actions {
  id                    String               @id @db.Uuid
  dsar_request_id       String               @db.Uuid
  item_id               String               @db.Uuid
  kind                  DsarItemActionKind
  status                DsarItemActionStatus @default(REQUESTED)
  requested_by_admin_id String?              @db.Uuid
  batch_id              String?              @db.Uuid
  reason                String?
  error                 String?
  hash_before           String?
  requested_at          DateTime             @default(now())
  completed_at          DateTime?
  dsar_requests         DsarRequest          @relation(fields: [dsar_request_id], references: [id], onDelete: Cascade)
  subject_data_items    subject_data_items   @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([dsar_request_id, item_id, kind])
  @@index([batch_id])
  @@index([dsar_request_id, status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model import_batches {
  id                  String            @id @db.Uuid
  subject_id          String            @db.Uuid
  type                DataItemType      @default(PHOTO)
  project_id          String?           @db.Uuid
  status              ImportBatchStatus @default(OPEN)
  created_by_admin_id String?           @db.Uuid
  items_total         Int               @default(0)
  items_done          Int               @default(0)
  items_failed        Int               @default(0)
  note                String?
  closed_at           DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime
  projects            Project?          @relation(fields: [project_id], references: [id])
  data_subjects       Subject           @relation(fields: [subject_id], references: [masterUserId], onDelete: Cascade)

  @@index([status])
  @@index([subject_id, created_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subject_data_items {
  id                   String              @id @db.Uuid
  subject_id           String              @db.Uuid
  type                 DataItemType
  origin               DataItemOrigin
  source_table         String
  source_id            String              @db.Uuid
  project_id           String?             @db.Uuid
  session_id           String?             @db.Uuid
  storage_path         String?
  content_hash         String?
  captured_at          DateTime?
  shared_subject_count Int                 @default(1)
  redacted_available   Boolean             @default(false)
  deleted_at           DateTime?
  indexed_at           DateTime            @default(now())
  meta                 Json?
  dsar_item_actions    dsar_item_actions[]
  data_subjects        Subject             @relation(fields: [subject_id], references: [masterUserId], onDelete: Cascade)

  @@unique([subject_id, type, source_table, source_id])
  @@index([subject_id, deleted_at, captured_at(sort: Desc), id(sort: Desc)])
  @@index([subject_id, deleted_at])
  @@index([subject_id, type, captured_at])
}

